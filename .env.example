# Server-side environment for the portfolio chatbot (Vercel function /api/chat).
# Set these in the Vercel project settings (Environment Variables). Never put
# real keys in this file or anywhere in the frontend bundle.
#
# Required: Google AI Studio API key for Gemini.
GEMINI_API_KEY=

# Optional: Gemini model id. Defaults to gemini-3.5-flash-lite when unset.
GEMINI_MODEL=gemini-3.5-flash-lite
